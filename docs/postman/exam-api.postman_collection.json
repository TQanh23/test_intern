{
  "info": {
    "name": "Exam API",
    "description": "API danh sách đề và nộp bài.\n\nChuẩn bị:\n1. Tạo token cho student mẫu:\n   docker compose exec app php artisan tinker --execute=\"echo App\\Models\\User::where('email','student@example.com')->first()->createToken('postman')->plainTextToken;\"\n2. Bắt đầu một bài trên web, lấy id trên URL /attempts/<id>.\n3. Điền token và attempt_id vào biến của collection rồi chạy lần lượt từ trên xuống.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "attempt_id", "value": "" }
  ],
  "item": [
    {
      "name": "Danh sách đề",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/exams"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và có data, links, meta', () => {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.keys('data', 'links', 'meta');",
              "    pm.expect(body.meta.per_page).to.eql(10);",
              "});",
              "pm.test('Mỗi đề chỉ có 4 trường, không có câu hỏi', () => {",
              "    pm.response.json().data.forEach(exam => {",
              "        pm.expect(exam).to.have.keys('id', 'name', 'duration_minutes', 'questions_count');",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách đề khi không có token",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/exams"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 dạng JSON dù không gửi Accept', () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().message).to.eql('Unauthenticated.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Nộp bài",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"answers\": {}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/attempts/{{attempt_id}}/submit",
        "description": "answers có dạng {\"<question_id>\": <option_id>}. Câu bỏ trống thì không gửi. Nộp quá giờ vẫn trả 200, chấm theo các đáp án đã lưu."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và bài đã được chấm', () => {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.status).to.eql('submitted');",
              "    pm.expect(data.score).to.be.a('number');",
              "    pm.expect(data.questions).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Nộp lại bài đã nộp",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"answers\": {}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/attempts/{{attempt_id}}/submit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 với lỗi attempt', () => {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().errors.attempt[0]).to.eql('Bài này đã được nộp.');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
