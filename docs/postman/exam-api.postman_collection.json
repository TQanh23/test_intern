{
  "info": {
    "name": "Exam API",
    "description": "API đăng nhập, danh sách đề, gói IELTS, xem thử tài liệu và nộp bài.\n\nChuẩn bị:\n1. Bắt đầu một bài trên web, lấy id trên URL /attempts/<id>.\n2. Điền attempt_id vào biến của collection rồi chạy lần lượt từ trên xuống. Request \"Đăng nhập\" tự gán biến token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "attempt_id", "value": "" },
    { "key": "document_id", "value": "" },
    { "key": "preview_url", "value": "" }
  ],
  "item": [
    {
      "name": "Đăng nhập",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"student@example.com\",\n    \"password\": \"password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và có token', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách đề",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/exams"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và có data, links, meta', () => {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.keys('data', 'links', 'meta');",
              "    pm.expect(body.meta.per_page).to.eql(10);",
              "});",
              "pm.test('Mỗi đề chỉ có 4 trường, không có câu hỏi', () => {",
              "    pm.response.json().data.forEach(exam => {",
              "        pm.expect(exam).to.have.keys('id', 'name', 'duration_minutes', 'questions_count');",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách đề khi không có token",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/exams"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 dạng JSON dù không gửi Accept', () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().message).to.eql('Unauthenticated.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách gói IELTS level 1",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/packages?level=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và chỉ có gói level 1', () => {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.keys('data', 'links', 'meta');",
              "    body.data.forEach(item => pm.expect(item.level).to.eql(1));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Chi tiết gói và mục lục",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/packages/mindset-for-ielts-level-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, có units và documents, không có file_path', () => {",
              "    pm.response.to.have.status(200);",
              "    const units = pm.response.json().data.units;",
              "    pm.expect(units.length).to.be.above(0);",
              "    pm.expect(units[0].documents[0]).to.not.have.property('file_path');",
              "});",
              "const pdf = pm.response.json().data.units[0].documents.find(doc => doc.type === 'pdf');",
              "pm.collectionVariables.set('document_id', pdf.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Xin link xem thử PDF",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/documents/{{document_id}}/preview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và có link có chữ ký', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.url).to.include('signature=');",
              "});",
              "pm.collectionVariables.set('preview_url', pm.response.json().data.url);"
            ]
          }
        }
      ]
    },
    {
      "name": "Mở link xem thử",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{preview_url}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và là PDF, không cần token', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/pdf');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Nộp bài",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"answers\": {}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/attempts/{{attempt_id}}/submit",
        "description": "answers có dạng {\"<question_id>\": <option_id>}. Câu không gửi thì lấy đáp án đã autosave, gửi null để bỏ chọn. Nộp quá giờ vẫn trả 200, chấm theo các đáp án đã lưu."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 và bài đã được chấm', () => {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.status).to.eql('submitted');",
              "    pm.expect(data.score).to.be.a('number');",
              "    pm.expect(data.questions).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Nộp lại bài đã nộp",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"answers\": {}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/attempts/{{attempt_id}}/submit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 với lỗi attempt', () => {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().errors.attempt[0]).to.eql('Bài này đã được nộp.');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
