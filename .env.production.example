# Copy thành .env.production (file này không commit) rồi đổi mọi giá trị change-me.
# Tạo APP_KEY: echo "base64:$(openssl rand -base64 32)"
APP_NAME=Laravel
# staging: vẫn seed dữ liệu mẫu khi database trống. production: không seed.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=exam
DB_USERNAME=exam
DB_PASSWORD=change-me

# Container mysql đọc các biến này khi tạo database lần đầu, phải trùng với DB_* ở trên.
MYSQL_DATABASE=exam
MYSQL_USER=exam
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Container mongo tạo user root này lần đầu, MONGODB_URI phải dùng đúng user và mật khẩu đó.
MONGO_INITDB_ROOT_USERNAME=exam
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGODB_URI=mongodb://exam:change-me@mongo:27017/?authSource=admin
MONGODB_DATABASE=exam

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
